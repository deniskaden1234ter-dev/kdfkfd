        Time = 4,
    })
end)

NotificationGroup:AddButton("Long Notification", function()
    Library:Notify({
        Title = "Long Notification",
        Description = "This notification stays visible for a little longer.",
        Time = 8,
    })
end)

NotificationGroup:AddButton("Persistent Notification", function()
    local Notification = Library:Notify({
        Title = "Persistent",
        Description = "This notification will remain until destroyed.",
        Persist = true,
    })

    task.delay(5, function()
        if Notification and not Notification.Destroyed then
            Notification:Destroy()
        end
    end)
end)

